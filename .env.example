# Copy to .env.local (never commit .env.local).
# Firebase web config: Firebase console > Project settings > Your apps > Web app.
# These values are public by design (they ship in the web bundle); App Check is what protects the API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Cloud attacker model (Firebase AI Logic model list). Default: gemini-3.5-flash-lite (no billing, ~1 s per call).
VITE_ATTACKER_MODEL=
# Production only: reCAPTCHA Enterprise site key for App Check.
# In development (npm run dev) the App Check debug provider is used instead: copy the debug token that appears in the
# browser console and register it in Firebase console > Security > App Check > Apps > Manage debug tokens.
VITE_RECAPTCHA_SITE_KEY=
